0,1,0,1,10
0,2,0,2,10
0,3,0,3,10
0,4,0,4,9
1,2          // middle of a FIFO
1,1          // head of a FIFO
1,4          // the only order at 9: the level disappears
1,4          // already cancelled
1,77         // never existed
0,5,1,10,9   // only order 3 is left to match
1,3          // order 3 was filled
