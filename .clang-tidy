# Applied to the shipped code (src/, include/, app/). Warnings are errors in check.sh.
#
# Disabled deliberately:
#   modernize-use-nodiscard  [[nodiscard]] marks results whose loss is a bug (add, cancel,
#                            fill_best, reserve_*); on every trivial getter it would bury that.
#   modernize-avoid-c-arrays small fixed stack buffers for formatting are clearer as arrays.
#   readability-magic-numbers, -identifier-length, -braces-around-statements,
#   -else-after-return, -implicit-bool-conversion, -uppercase-literal-suffix,
#   -function-cognitive-complexity, -math-missing-parentheses: style preferences.
#   bugprone-easily-swappable-parameters: noisy for (id, qty) style APIs.
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -readability-else-after-return,
  -readability-implicit-bool-conversion,
  -readability-uppercase-literal-suffix,
  -readability-function-cognitive-complexity,
  -readability-math-missing-parentheses
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/include/matcher/.*'
